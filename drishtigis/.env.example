# DrishtiGIS Frontend — Environment Variables Template
# =============================================================================
# For local development: copy this file to .env.local in drishtigis/
# For Vercel production: configure in Vercel Project Settings -> Environment Variables
# =============================================================================

# Public URL of the FastAPI backend API on AWS EC2 (or localhost for dev)
# Production example: http://15.206.185.179
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Base API path for versioned endpoints
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# Satellite basemap tile URL template (XYZ format)
NEXT_PUBLIC_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# Supabase Authentication (Real Users)
# Public project URL and publishable anon key (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# SIH Demo Evaluation Accounts
# Comma-separated list of accounts routed through DrishtiGIS testing authentication
NEXT_PUBLIC_DEMO_AUTH_EMAILS=demo-public@drishtigis.in,demo-surveyor@drishtigis.in,demo-reviewer@drishtigis.in,demo-admin@drishtigis.in
