# DrishtiGIS Backend — Environment Variables Template
# Copy this file to .env in backend/ and populate with production values.
# NEVER commit real secret values to git.

# 1. REQUIRED SECRETS
SECRET_KEY=change-me
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# 2. CORS & SECURITY
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_DEMO_ACCOUNTS=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
DEBUG=false
MAX_UPLOAD_SIZE_MB=100

# 3. OPTIONAL EXTERNAL SERVICES
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

