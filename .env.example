# =============================================================================
# DrishtiGIS — Environment Variables Template
# Copy this file to .env (backend) and drishtigis/.env.local (frontend)
# NEVER commit actual secret values.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# For local dev: use Supabase connection string or local PostGIS via Docker
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/drishtigis

# ---------------------------------------------------------------------------
# Supabase (hosted PostgreSQL + PostGIS)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key   # BACKEND ONLY — never expose to frontend

# ---------------------------------------------------------------------------
# Gemini (Google AI) — BACKEND ONLY
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# ---------------------------------------------------------------------------
# Backend settings
# ---------------------------------------------------------------------------
SECRET_KEY=your-secret-key-for-jwt-signing-min-32-chars
BACKEND_CORS_ORIGINS=http://localhost:3000
DEBUG=false

# ---------------------------------------------------------------------------
# Frontend (NEXT_PUBLIC_ prefix = safe to expose in browser bundle)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAP_TILE_URL=http://localhost:8000/tiles/bhopal/{z}/{x}/{y}.png

# ---------------------------------------------------------------------------
# Map providers (optional — free providers require no key)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-key     # optional, for MapTiler styles
