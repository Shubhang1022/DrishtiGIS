# =============================================================================
# DrishtiGIS — Production-Ready Environment Variables Template
# Copy this file to .env (backend) and drishtigis/.env.local (frontend)
# NEVER commit actual secret values to git.
# =============================================================================

# =============================================================================
# 1. REQUIRED SECRETS (Backend Only - NEVER expose to frontend or browser)
# =============================================================================
# Cryptographic secret used for signing JWT access tokens.
# Generate in production using: python -c "import secrets; print(secrets.token_urlsafe(32))"
# [Classification: REQUIRED_SECRET]
SECRET_KEY=your-production-jwt-secret-key-32-chars-minimum

# Database connection URL (PostgreSQL + PostGIS in production, SQLite fallback in local dev)
# Format: postgresql+asyncpg://user:password@host:port/dbname
# [Classification: REQUIRED_SECRET]
DATABASE_URL=sqlite+aiosqlite:///./drishtigis_dev.db

# =============================================================================
# 2. REQUIRED PUBLIC CONFIGURATION (Frontend Browser & Public Endpoints)
# =============================================================================
# Public URL of the FastAPI backend API (accessible by client browser)
# Example for production: https://api.drishtigis.in
# [Classification: REQUIRED_PUBLIC]
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Base API path for versioned endpoints
# [Classification: REQUIRED_PUBLIC]
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# Satellite basemap tile URL template (XYZ format)
# [Classification: REQUIRED_PUBLIC]
NEXT_PUBLIC_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# =============================================================================
# 3. PRODUCTION SECURITY & GOVERNANCE FLAGS
# =============================================================================
# Demo Accounts Gate: Set to false in production to disable pre-seeded privileged demo accounts
# [Classification: REQUIRED_SECRET / SECURITY]
ENABLE_DEMO_ACCOUNTS=true

# HTTPS Cookie Security: Set to true in production over HTTPS
# [Classification: REQUIRED_SECRET / SECURITY]
COOKIE_SECURE=false

# Cookie SameSite attribute: 'lax' for same-site, 'none' for cross-domain HTTPS
# [Classification: REQUIRED_SECRET / SECURITY]
COOKIE_SAMESITE=lax

# Allowed frontend origins for CORS (comma-separated or JSON list)
# Example for production: https://app.drishtigis.in,https://drishtigis.in
# [Classification: REQUIRED_SECRET / SECURITY]
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server environment mode (development, staging, production)
# [Classification: REQUIRED_PUBLIC]
ENVIRONMENT=development
DEBUG=false

# Maximum upload payload size in MB for drone GeoTIFFs / Shapefile ZIPs
# [Classification: OPTIONAL]
MAX_UPLOAD_SIZE_MB=100

# =============================================================================
# 4. OPTIONAL AI & LLM ASSISTANT PROVIDERS (Graceful fallback if absent)
# =============================================================================
# DrishtiGIS operates fully without paid LLM keys via its built-in Grounded Tool Engine.
# To enable external natural-language generative tool calling, provide one of:
# [Classification: OPTIONAL]
OPENROUTER_API_KEY=
GEMINI_API_KEY=
LLM_API_KEY=
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemini-2.5-flash

# =============================================================================
# 5. OPTIONAL HOSTED INFRASTRUCTURE (Supabase / Object Storage)
# =============================================================================
# [Classification: OPTIONAL]
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# Optional MapTiler API Key (if using custom vector basemaps instead of OpenFreeMap)
# [Classification: OPTIONAL]
NEXT_PUBLIC_MAPTILER_KEY=
